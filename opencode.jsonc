{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp@4.7.3"],
      "enabled": true
    },
    "shadcn": {
      "type": "local",
      "command": ["npx", "-y", "shadcn@latest", "mcp"],
      "enabled": true
    },
    "blender": {
      "type": "local",
      "command": ["uvx", "--python", "3.11", "--from", "mcp-for-blender", "mcp-for-blender", "--port", "9876"],
      "enabled": true,
      "environment": {
        "BLENDER_HOST": "localhost",
        "BLENDER_PORT": "9876",
        "UV_PYTHON_PREFERENCE": "only-managed",
        "DISABLE_TELEMETRY": "true"
      }
    }
  },
  "agent": {
    "orchestrator-architect": {
      "model": "anonrouter/openai/gpt-5.6-sol-pro",
      "mode": "primary",
      "description": "Coordinator: strongest verified reasoning model for gate decisions and delegation."
    },
    "geometry-extractor": {
      "model": "anonrouter/anthropic/claude-sonnet-5.5",
      "mode": "subagent",
      "description": "Maintains sourced listing identities and image-space floor/unit overlays."
    },
    "blender-builder": {
      "model": "anonrouter/openai/gpt-6-luna",
      "mode": "subagent",
      "description": "Optional exterior-only Blender work from verified inputs when the image-first plan requires it."
    },
    "web-3d-builder": {
      "model": "anonrouter/openai/gpt-6.1-sol",
      "mode": "subagent",
      "description": "Builds the Next.js, GSAP and SVG floor selector; Three.js is optional."
    },
    "cinematic-director": {
      "model": "anonrouter/anthropic/claude-sonnet-5.5",
      "mode": "subagent",
      "disabled": true,
      "description": "Parked. Video and walkthrough production are outside the selector workflow."
    },
    "visual-qa-reviewer": {
      "model": "anonrouter/google/gemini-3.8-flash",
      "mode": "subagent",
      "description": "Read-only visual and performance review of Playwright artifacts. Image input not verified on anonrouter."
    },
    "doc-scribe": {
      "model": "anonrouter/deepseek/deepseek-v4.1-flash",
      "mode": "subagent",
      "description": "Repetitive documentation and boilerplate under docs/. Low cost tier."
    }
  }
}
